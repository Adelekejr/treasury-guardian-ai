{
  "name": "treasury-guardian-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "contracts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "npm run test --workspace contracts",
    "compile:contracts": "npm run compile --workspace contracts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:contracts && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
