# ---------------------------------------------------------------------------
# Frontend configuration (Vite).
# EVERYTHING with a VITE_ prefix is bundled into the browser build and is
# PUBLIC. Never put a private key, mnemonic, keystore path or provider secret
# in this file. The Hardhat deployer key lives in contracts/.env only.
# ---------------------------------------------------------------------------

# Arbitrum Sepolia (testnet) — the only chain this app will operate on.
VITE_CHAIN_ID=421614
VITE_CHAIN_NAME="Arbitrum Sepolia"
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_EXPLORER_URL=https://sepolia.arbiscan.io

# Deployed TreasuryGuardian address. Leave empty until you have deployed;
# the app then reports the "contract unavailable" state (or runs in Demo Mode).
VITE_GUARDIAN_ADDRESS=

# Treasury address to monitor (the contract itself, or an EOA you control).
VITE_TREASURY_ADDRESS=

# Comma-separated recipient allowlist used by the deterministic policy engine.
# Must mirror the allowlist compiled into the deployed contract.
VITE_ALLOWED_RECIPIENTS=

# Maximum single testnet transfer, in ETH. Anything above this is BLOCKED.
VITE_MAX_TRANSFER_ETH=0.05

# Comma-separated method allowlist (labels shown in the UI / hashed on-chain).
VITE_ALLOWED_METHODS=transferNative,approvePayout

# Event polling interval in milliseconds. The public Arbitrum RPC has NO
# WebSocket support, so the app polls getLogs. Keep this >= 4000.
VITE_POLL_INTERVAL_MS=8000

# How many blocks back the poller reads on first load.
VITE_LOOKBACK_BLOCKS=5000

# Demo Mode: "true" ships deterministic fixtures and never touches the network.
# "false" uses the live RPC and falls back to Demo Mode if it is unreachable.
VITE_DEMO_MODE=true

# Optional: repository link shown on the Settings/about screen.
VITE_REPO_URL=https://github.com/adelekejr/treasury-guardian-ai

# Optional: AI provider endpoint. The API KEY IS NOT SET HERE — it is typed in
# at runtime and held in memory for the session only. Leave the endpoint empty
# to use the bundled local mock adapter.
VITE_AI_ENDPOINT=
VITE_AI_MODEL=
