# secrets — must never be committed
.env
.env.*
!.env.example
CLAUDE.md
*.keystore
keystore/
*.key
*.pem

# dependencies / build output
node_modules/
dist/
dist-ssr/
coverage/
.vercel/
.vite/

# hardhat
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

# agent skills installed with `npx skills add`. The content is 19 MB of
# third-party files, so it is not vendored. skills-lock.json pins the source
# and a SHA-256 per skill, and `npx skills experimental_install` restores them.
# Note: a hand-written project skill placed in .claude/skills/ would also be
# ignored here.
/.agents/
/.claude/skills/

# editors / os
.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json
npm-debug.log*
