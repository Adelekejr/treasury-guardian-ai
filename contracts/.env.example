# ---------------------------------------------------------------------------
# Hardhat-only configuration. This file is the only place a deployer key may
# live, and contracts/.env is gitignored. Nothing here is bundled into the
# frontend. Use a throwaway testnet key funded with Arbitrum Sepolia ETH.
# ---------------------------------------------------------------------------

# Arbitrum Sepolia (testnet), chain id 421614.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Deployer private key for the testnet only. NEVER a key holding real funds.
DEPLOYER_PRIVATE_KEY=

# Constructor arguments. All addresses and limits come from here rather than
# from hardcoded values in the Solidity source.
GUARDIAN_APPROVER=
GUARDIAN_ALLOWED_RECIPIENTS=
GUARDIAN_ALLOWED_METHODS=transferNative,approvePayout
GUARDIAN_MAX_TRANSFER_ETH=0.05

# Optional: Arbiscan key for `hardhat verify` on Arbitrum Sepolia.
ARBISCAN_API_KEY=
